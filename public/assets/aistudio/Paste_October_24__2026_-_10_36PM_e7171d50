        ];

        // Dữ liệu ngày giỗ & sự kiện mẫu
        const eventsData = [
            {
                id: 1,
                title: "Lễ Giỗ Thủy Tổ Cụ Nguyễn Văn Căn",
                lunarDate: "15 tháng Giêng (Âm lịch)",
                solarDate: "Hàng năm sau Tết Nguyên Đán",
                rolePerson: "Cụ Thủy Tổ Khởi",
                host: "Trưởng Tộc Nguyễn Quang Hải chủ trì",
                location: "Nhà thờ Tổ dòng họ (Chương Mỹ, Hà Nội)",
                importance: "Đại lễ toàn thể gia tộc"
            },
            {
                id: 2,
                title: "Ngày Kỵ Cụ Bà Trần Thị Mùi (Chính Thất)",
                lunarDate: "08 tháng 4 (Âm lịch)",
                solarDate: "Khoảng tháng 5 Dương lịch",
                rolePerson: "Cụ Bà Thủy Tổ",
                host: "Ban Khánh tiết & Chi 1 chuẩn bị",
                location: "Từ đường dòng họ",
                importance: "Lễ kỵ quan trọng"
            },
            {
                id: 3,
                title: "Lễ Giỗ Trưởng Chi 1 (Cụ Nguyễn Văn Đức)",
                lunarDate: "20 tháng 10 (Âm lịch)",
                solarDate: "Thường niên",
                rolePerson: "Cụ Đức (Đời 2)",
                host: "Gia đình nhánh Trưởng Chi 1",
                location: "Tại nhà Trưởng Chi",
                importance: "Chi phái nội tộc"
            }
        ];

        // Quản lý điều hướng SPA
        function navigate(viewName) {
            // Cập nhật views
            const views = document.querySelectorAll('.spa-view');
            views.forEach(v => v.classList.remove('active'));
            const targetView = document.getElementById(`view-${viewName}`);
            if (targetView) targetView.classList.add('active');

            // Cập nhật trạng thái active menu desktop
            document.querySelectorAll('.nav-btn').forEach(btn => {
                if (btn.getAttribute('data-view') === viewName) {
                    btn.classList.add('bg-amber-50', 'text-amber-800', 'font-bold');
                } else {
                    btn.classList.remove('bg-amber-50', 'text-amber-800', 'font-bold');
                }
            });

            // Cuộn trang lên đầu
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Toggle mobile menu
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
        function toggleMobileMenu() {
            mobileMenu.classList.add('hidden');
        }

        // Render Sơ đồ Cây gia phả (CSS Nested Tree)
        function renderFamilyTree() {
            const container = document.getElementById('family-tree-container');
            const rootMember = familyData.find(m => m.id === 1);
            if (!rootMember) return;

            function buildTreeNodeHtml(member) {
                const isMale = member.gender === 'Nam';
                const genderColor = isMale ? 'text-blue-600' : 'text-rose-500';
                const badgeColor = member.isAlive ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500';

                let childrenHtml = '';
                if (member.children && member.children.length > 0) {
                    const childNodes = member.children
                        .map(cid => familyData.find(m => m.id === cid))
                        .filter(Boolean)
                        .map(child => buildTreeNodeHtml(child))
                        .join('');
                    childrenHtml = `<ul>${childNodes}</ul>`;
                }

                return `
                    <li>
                        <div class="tree-node ${member.gen === 1 ? 'root' : ''}" onclick="showMemberModal(${member.id})">
                            <div class="flex items-center justify-between text-[11px] mb-1">
                                <span class="font-bold text-amber-700">Đời ${member.gen}</span>
                                <span class="px-1.5 py-0.5 rounded text-[10px] ${badgeColor}">
                                    ${member.isAlive ? 'Còn sống' : 'Đã mất'}
                                </span>
                            </div>
                            <div class="font-bold text-slate-900 text-sm flex items-center justify-center gap-1.5">
                                <i class="fa-solid ${isMale ? 'fa-mars text-blue-600' : 'fa-venus text-rose-500'}"></i>
                                ${member.name}
                            </div>
                            <div class="text-[11px] text-slate-500 mt-0.5">
                                ${member.birth} ${member.death ? ' - ' + member.death : ''}
                            </div>
                            <div class="text-[10px] text-amber-800/80 font-medium truncate max-w-[140px] mt-1">
                                ${member.role}
                            </div>
                        </div>
                        ${childrenHtml}
                    </li>
                `;
            }

            container.innerHTML = `<ul>${buildTreeNodeHtml(rootMember)}</ul>`;
        }

        // Render Danh sách thành viên (Thẻ Card)
        function renderMembers(dataToRender = familyData) {
            const grid = document.getElementById('membersGrid');
            const noData = document.getElementById('noMembersFound');
            grid.innerHTML = '';

            if (dataToRender.length === 0) {
                noData.classList.remove('hidden');
                return;
            } else {
                noData.classList.add('hidden');
            }

            dataToRender.forEach(m => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between";
                
                const initials = m.name.split(' ').slice(-2).map(w => w[0]).join('');
                const avatarBg = m.gender === 'Nam' ? 'bg-blue-100 text-primary' : 'bg-rose-100 text-rose-600';

                card.innerHTML = `
                    <div>
                        <div class="flex items-start gap-3.5 mb-3">
                            <div class="w-12 h-12 rounded-xl ${avatarBg} font-bold flex items-center justify-center text-base shrink-0">
                                ${initials}
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h3 class="font-bold text-slate-900 truncate text-base">${m.name}</h3>
                                    <span class="text-xs ${m.gender === 'Nam' ? 'text-blue-500' : 'text-rose-500'}">
                                        <i class="fa-solid ${m.gender === 'Nam' ? 'fa-mars' : 'fa-venus'}"></i>
                                    </span>
                                </div>
                                <span class="inline-block mt-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                    Thế hệ ${m.gen}
                                </span>
                            </div>
                        </div>

                        <div class="text-xs text-slate-600 space-y-1.5 my-3 pt-2 border-t border-slate-100">
                            <div><i class="fa-regular fa-clock w-4 text-slate-400"></i> Năm sinh: <strong class="text-slate-700">${m.birth}</strong> ${m.death ? ` - Mất: ${m.death}` : ''}</div>
                            <div><i class="fa-solid fa-tag w-4 text-slate-400"></i> Vai trò: <span class="text-slate-700">${m.role}</span></div>
                            <div class="truncate"><i class="fa-solid fa-ring w-4 text-slate-400"></i> Hôn phối: ${m.spouse || 'Chưa cập nhật'}</div>
                        </div>
                    </div>

                    <button onclick="showMemberModal(${m.id})" class="w-full mt-2 py-2 rounded-lg bg-slate-50 hover:bg-amber-500 hover:text-slate-950 font-medium text-xs text-slate-700 transition border border-slate-200">
                        Chi tiết tiểu sử <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                `;
                grid.appendChild(card);
            });
        }

        // Lọc thành viên
        function applyMemberFilter() {
            const query = document.getElementById('memberFilterSearch').value.toLowerCase().trim();
            const gen = document.getElementById('memberFilterGen').value;
            const gender = document.getElementById('memberFilterGender').value;

            const filtered = familyData.filter(m => {
                const matchName = m.name.toLowerCase().includes(query) || (m.alias && m.alias.toLowerCase().includes(query));
                const matchGen = gen === 'all' || m.gen.toString() === gen;
                const matchGender = gender === 'all' || m.gender === gender;
                return matchName && matchGen && matchGender;
            });

            renderMembers(filtered);
        }

        // Quick Search từ Hero Banner
        function handleQuickSearch(e) {
            e.preventDefault();
            const searchVal = document.getElementById('quickSearchInput').value.trim();
            if (!searchVal) return;

            navigate('members');
            document.getElementById('memberFilterSearch').value = searchVal;
            applyMemberFilter();
        }

        // Render Lịch giỗ & Sự kiện
        function renderEvents() {
            const container = document.getElementById('eventsListContainer');
            container.innerHTML = '';

            eventsData.forEach(ev => {
                const item = document.createElement('div');
                item.className = "p-5 rounded-xl border border-slate-200 hover:border-amber-300 transition bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-4";
                item.innerHTML = `
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-red-100 text-traditionalRed">
                                <i class="fa-solid fa-fire mr-1"></i> ${ev.importance}
                            </span>
                            <h4 class="font-bold text-slate-900 text-base">${ev.title}</h4>
                        </div>
                        <p class="text-sm text-slate-600">
                            <i class="fa-regular fa-moon text-amber-600 mr-1.5"></i> Âm lịch: <strong class="text-amber-800">${ev.lunarDate}</strong> 
                            <span class="text-slate-400 mx-1.5">|</span> 
                            <i class="fa-regular fa-sun text-orange-500 mr-1"></i> Dương lịch: <span>${ev.solarDate}</span>
                        </p>
                        <p class="text-xs text-slate-500">
                            <i class="fa-solid fa-user-shield text-slate-400 mr-1"></i> Phụ trách: ${ev.host}
                        </p>
                    </div>
                    <div class="text-right">
                        <button onclick="alert('Đã lưu thông báo nhắc hẹn cho sự kiện: ${ev.title}')" class="px-4 py-2 rounded-lg bg-white border border-slate-300 hover:border-amber-500 text-xs font-semibold text-slate-700 shadow-sm transition">
                            <i class="fa-regular fa-bell text-goldDark mr-1"></i> Nhắc nhở
                        </button>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        // Xử lý Modal chi tiết thành viên
        const memberModal = document.getElementById('memberModal');

        function showMemberModal(memberId) {
            const member = familyData.find(m => m.id === memberId);
            if (!member) return;

            document.getElementById('modalName').textContent = member.name;
            document.getElementById('modalGenBadge').textContent = `Thế hệ ${member.gen}`;
            document.getElementById('modalAlias').textContent = member.alias || 'Chưa cập nhật';
            document.getElementById('modalGender').textContent = member.gender;
            document.getElementById('modalBirth').textContent = member.birth;
            document.getElementById('modalStatus').innerHTML = member.isAlive 
                ? '<span class="text-emerald-600 font-bold">Còn sống</span>' 
                : `<span class="text-slate-500">Đã mất (${member.death || 'N/A'})</span>`;
            document.getElementById('modalSpouse').textContent = member.spouse || 'Chưa cập nhật';
            document.getElementById('modalBurial').textContent = member.burial || 'Đang cập nhật';
            document.getElementById('modalBio').textContent = member.bio || 'Chưa có dữ liệu tiểu sử chi tiết.';
            
            const initials = member.name.split(' ').slice(-2).map(w => w[0]).join('');
            document.getElementById('modalAvatar').textContent = initials;

            memberModal.classList.remove('hidden');
        }

        function closeModal() {
            memberModal.classList.add('hidden');
        }

        // Đóng modal khi bấm ra ngoài
        memberModal.addEventListener('click', (e) => {
            if (e.target === memberModal) closeModal();
        });

        // Xử lý nộp form góp ý
        function handleFeedbackSubmit(e) {
            e.preventDefault();
            alert("Cảm ơn bạn! Ban Quản Trị Gia Phả Số đã nhận được thông tin đóng góp và sẽ cập nhật sớm nhất.");
            e.target.reset();
            navigate('home');
        }

        // Cập nhật số liệu thống kê nhanh
        function updateStatsCounter() {
            const total = familyData.length;
            const alive = familyData.filter(m => m.isAlive).length;
            const dead = total - alive;
            const males = familyData.filter(m => m.gender === 'Nam').length;
            const females = total - males;

            document.getElementById('stat-total-quick').textContent = total;
            document.getElementById('stat-alive-quick').textContent = alive;
            document.getElementById('stat-dead-quick').textContent = dead;

            const totalEl = document.getElementById('stat-total');
            if (totalEl) totalEl.textContent = total;
            const ratioEl = document.getElementById('stat-ratio');
            if (ratioEl) ratioEl.textContent = `${males} / ${females}`;
        }

        // Khởi tạo ban đầu
        window.addEventListener('DOMContentLoaded', () => {
            renderFamilyTree();
            renderMembers();
            renderEvents();
            updateStatsCounter();
        });
    </script>
</body>
</html>
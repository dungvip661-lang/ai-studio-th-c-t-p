    <style>
        body {
            background-color: #f8fafc;
            color: #1e293b;
        }

        /* Hiệu ứng hoa văn đồng & hoàng gia */
        .royal-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #172554 100%);
        }
        
        .gold-border {
            border-color: #d4af37;
        }

        .gold-text {
            color: #d4af37;
        }

        /* Cấu trúc sơ đồ cây gia phả CSS Tree */
        .tree {
            display: flex;
            justify-content: center;
            overflow-x: auto;
            padding: 20px 10px;
        }
        .tree ul {
            padding-top: 20px; 
            position: relative;
            transition: all 0.5s;
            display: flex;
            justify-content: center;
        }
        .tree li {
            float: left; 
            text-align: center;
            list-style-type: none;
            position: relative;
            padding: 20px 10px 0 10px;
            transition: all 0.5s;
        }
        /* Đường kẻ nối ngang và dọc */
        .tree li::before, .tree li::after {
            content: '';
            position: absolute; 
            top: 0; 
            right: 50%;
            border-top: 2px solid #cbd5e1;
            width: 50%; 
            height: 20px;
        }
        .tree li::after {
            right: auto; 
            left: 50%;
            border-left: 2px solid #cbd5e1;
        }
        .tree li:only-child::after, .tree li:only-child::before {
            display: none;
        }
        .tree li:only-child { 
            padding-top: 0;
        }
        .tree li:first-child::before, .tree li:last-child::after {
            border: 0 none;
        }
        .tree li:last-child::before {
            border-right: 2px solid #cbd5e1;
            border-radius: 0 8px 0 0;
        }
        .tree li:first-child::after {
            border-radius: 8px 0 0 0;
        }
        .tree ul ul::before {
            content: '';
            position: absolute; 
            top: 0; 
            left: 50%;
            border-left: 2px solid #cbd5e1;
            width: 0; 
            height: 20px;
        }

        /* Thẻ thành viên trong cây */
        .tree-node {
            display: inline-block;
            border: 2px solid #e2e8f0;
            background: white;
            padding: 10px 14px;
            border-radius: 12px;
            text-decoration: none;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: all 0.25s ease;
            min-width: 155px;
            cursor: pointer;
        }
        .tree-node:hover {
            border-color: #d4af37;
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(212, 175, 55, 0.2);
        }
        .tree-node.root {
            border-color: #d4af37;
            background: linear-gradient(to bottom, #ffffff, #fefce8);
        }

        /* Tab chuyển trang ẩn/hiện */
        .spa-view {
            display: none;
        }
        .spa-view.active {
            display: block;
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
